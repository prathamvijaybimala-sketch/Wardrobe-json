# Google Drive — service account JSON (inline base64 or file path)
# Option A: Path to service account JSON file on disk
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
# Option B: Base64-encoded service account JSON (for Railway env vars)
# GOOGLE_SERVICE_ACCOUNT_B64=<base64-encoded-json>

# Google Drive folder ID containing clothing photos
GOOGLE_DRIVE_FOLDER_ID=

# Gemini API key (from Google AI Studio)
GEMINI_API_KEY=

# Gemini model name (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# GitHub personal access token (needs repo scope)
GITHUB_TOKEN=

# GitHub repo in "owner/repo" format (the data/catalog repo)
GITHUB_REPO=

# Branch to commit to (default: main)
GITHUB_BRANCH=main

# Path within the repo where images are stored (default: images)
IMAGE_ASSETS_PATH=images
